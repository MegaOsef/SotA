<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<Script file="Dashboard.lua" />

	<!-- template for Bid entries -->
	<Button name="SOTA_LootTemplate" hidden="true" virtual="true">
		<Size>
			<AbsDimension x="296" y="36" />
		</Size>
		<Frames>
			<Frame name="$parentItem">
				<Size>
					<AbsDimension x="36" y="36" />
				</Size>
				<Anchors>
					<Anchor point="LEFT">
						<Offset>
							<AbsDimension x="0" y="0" />
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture name="$parentTexture" file="">
							<Anchors>
								<Anchor point="TOP" relativeTo="$parentHeaderTexture">
									<Offset>
										<AbsDimension x="0" y="-14" />
									</Offset>
								</Anchor>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Layers>
			<Layer>
				<FontString name="$parentItemSoftLink" justifyH="LEFT" inherits="GameFontNormal"
					hidden="true">
					<Size>
						<AbsDimension x="296" y="16" />
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="0" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="1" g="1" b="1" />
				</FontString>
				<FontString name="$parentItemLink" justifyH="LEFT" inherits="GameFontNormal"
					hidden="true">
					<Size>
						<AbsDimension x="296" y="16" />
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="0" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="1" g="1" b="1" />
				</FontString>
				<!-- Item name -->
				<FontString name="$parentItemName" justifyH="LEFT" inherits="GameFontNormal"
					font="Fonts\FRIZQT__.TTF">
					<FontHeight val="12" />
					<Size>
						<AbsDimension x="296" y="10" />
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="37" y="-1" />
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="1" g="1" b="1" />
				</FontString>
				<!-- Item Prio -->
				<FontString name="$parentItemPrio" justifyH="LEFT" inherits="GameFontNormal"
					font="Fonts\FRIZQT__.TTF">
					<FontHeight val="10" />
					<Size>
						<AbsDimension x="296" y="10" />
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="37" y="-13" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<!-- Item Notes -->
				<FontString name="$parentItemNotes" justifyH="LEFT" inherits="GameFontNormal"
					font="Fonts\FRIZQT__.TTF">
					<FontHeight val="10" />
					<Size>
						<AbsDimension x="296" y="10" />
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="37" y="-23" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick>
				SOTA_OnLootClick(this);
			</OnClick>
			<OnEnter>
				getglobal(this:GetName().."BG"):SetVertexColor(1, 1, 1, 1)
				local link = getglobal(this:GetName() .. "ItemSoftLink"):GetText();
				if link and link ~= "" then
				GameTooltip:SetOwner(this, "ANCHOR_RIGHT");
				GameTooltip:SetHyperlink(link);
				GameTooltip:Show();
				else
				SOTA_ShowDashboardToolTip(this, getglobal(this:GetName() .. "ItemName"):GetText() or
				"");
				end
			</OnEnter>
			<OnLeave>
				getglobal(this:GetName().."BG"):SetVertexColor(0.5, 0.5, 0.3, 1)
				GameTooltip:Hide();
			</OnLeave>
			<OnLoad>
				this:GetScript("OnLeave")(this)
			</OnLoad>
		</Scripts>
		<NormalTexture name="$parentBG">
			<Color r="0.0" g="0.0" b="0.2" a="1" />
		</NormalTexture>
	</Button>

	<!-- SotA Dashboard -->
	<Frame name="DashboardUIFrame" parent="UIParent" toplevel="true" hidden="true">
		<Size>
			<AbsDimension x="296" y="40" />
		</Size>
		<Anchors>
			<Anchor point="TOPLEFT">
				<Offset x="0" y="0" />
			</Anchor>
		</Anchors>
		<Frames>
			<!-- Current item frame -->
			<Frame name="$parentItem" enableMouse="true">
				<Size>
					<AbsDimension x="296" y="40" />
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="0" y="0" />
						</Offset>
					</Anchor>
				</Anchors>
				<Backdrop tile="true" bgFile="Interface\DialogFrame\UI-DialogBox-Background">
					<BackgroundInsets>
						<AbsInset left="0" right="0" top="0" bottom="0" />
					</BackgroundInsets>
					<EdgeSize>
						<AbsValue val="16" />
					</EdgeSize>
					<TileSize>
						<AbsValue val="16" />
					</TileSize>
				</Backdrop>
				<Scripts>
					<OnEnter>
						SOTA_OnDashboardEnter(this);
					</OnEnter>
					<OnLeave>
						SOTA_OnDashboardLeave();
					</OnLeave>
				</Scripts>
				<!-- "buttons" -->
				<Frames>
					<!-- Button 2A: Transaction Log ("Note") -->
					<Button name="$parentTransactionLogButton" inherits="ActionButtonTemplate"
						frameStrata="MEDIUM" hidden="false">
						<Size>
							<AbsDimension x="20" y="20" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="0" y="0" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\INV_Misc_Note_05.blp" />
						<PushedTexture file="Interface\ICONS\INV_Misc_Note_03.blp" />
						<Scripts>
							<OnClick>
								SOTA_OpenTransactionsLogUI();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "Open Transaction Log");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
						</Scripts>
					</Button>
					<!-- Report Raid DKP to Officer Chat -->
					<Button name="$parentReportRaidDkpButton" inherits="ActionButtonTemplate"
						frameStrata="MEDIUM" hidden="false">
						<Size>
							<AbsDimension x="20" y="20" />
						</Size>
						<Anchors>
							<Anchor point="TOPRIGHT">
								<Offset>
									<AbsDimension x="0" y="0" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\Ability_Warrior_RallyingCry.blp" />
						<PushedTexture file="Interface\ICONS\Ability_Warrior_BattleShout.blp" />
						<Scripts>
							<OnClick>
								SOTA_ReportRaidDkpButton_OnClick();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "Report raid DKP to officer chat");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
						</Scripts>
					</Button>
					<!-- Button 3A: Configuration ("Gear") -->
					<Button name="$parentConfigurationButton" inherits="ActionButtonTemplate"
						frameStrata="MEDIUM" hidden="false">
						<Size>
							<AbsDimension x="20" y="20" />
						</Size>
						<Anchors>
							<Anchor point="TOPRIGHT">
								<Offset>
									<AbsDimension x="0" y="-20" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\INV_Misc_Gear_01.blp" />
						<PushedTexture file="Interface\ICONS\INV_Misc_Gear_02.blp" />
						<Scripts>
							<OnClick>
								SOTA_OpenConfigurationUI();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "Open Configuration screen");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
						</Scripts>
					</Button>
					<!-- Button 3A: Export Raven Logs -->
					<Button name="$parentExportRavenLogsButton" inherits="ActionButtonTemplate"
						frameStrata="MEDIUM" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="LEFT">
								<Offset>
									<AbsDimension x="23" y="0" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\Ability_Hunter_Pet_Vulture.blp" />
						<PushedTexture file="Interface\ICONS\INV_Misc_Head_Troll_02.blp" />
						<Scripts>
							<OnClick>
								SOTA_ExportRavenLogsButton_OnClick();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "Get export string, to import in RavenApp");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
						</Scripts>
					</Button>
					<!-- Button 3A: Clear Raven Logs -->
					<Button name="$parentClearRavenLogsButton" inherits="ActionButtonTemplate"
						frameStrata="MEDIUM" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="RIGHT">
								<Offset>
									<AbsDimension x="-23" y="0" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\Ability_Vanish.blp" />
						<PushedTexture file="Interface\ICONS\INV_Misc_Head_Kobold_01.blp" />
						<Scripts>
							<OnClick>
								SOTA_ClearRavenLogsButton_OnClick();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "Clear Raven Logs (new session)");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
						</Scripts>
					</Button>
					<Button name="$parentPreviousAuctionsButton" inherits="ActionButtonTemplate"
						frameStrata="MEDIUM" hidden="false">
						<Size>
							<AbsDimension x="20" y="20" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="0" y="-20" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\INV_Hammer_18.blp" />
						<PushedTexture file="Interface\ICONS\INV_Hammer_20.blp" />
						<Scripts>
							<OnClick>
								SOTA_OpenPreviousAuctionsUI();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "Previous auctions");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
						</Scripts>
					</Button>
					<Button name="$parentShareBossDkp" hidden="false">
						<Size>
							<AbsDimension x="270" y="26" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="0" y="26" />
								</Offset>
							</Anchor>
						</Anchors>
						<Frames>
							<Frame name="$parentIcon">
								<Size>
									<AbsDimension x="26" y="26" />
								</Size>
								<Anchors>
									<Anchor point="LEFT">
										<Offset>
											<AbsDimension x="0" y="0" />
										</Offset>
									</Anchor>
								</Anchors>
								<Layers>
									<Layer level="ARTWORK">
										<Texture name="$parentTexture" file="">
											<Anchors>
												<Anchor point="TOP"
													relativeTo="$parentHeaderTexture">
													<Offset>
														<AbsDimension x="0" y="-14" />
													</Offset>
												</Anchor>
											</Anchors>
										</Texture>
									</Layer>
								</Layers>
							</Frame>
						</Frames>
						<Layers>
							<Layer>
								<!-- Boss name -->
								<FontString name="$parentBossName" justifyH="LEFT"
									inherits="GameFontNormal"
									font="Fonts\FRIZQT__.TTF">
									<FontHeight val="12" />
									<Size>
										<AbsDimension x="296" y="10" />
									</Size>
									<Anchors>
										<Anchor point="TOPLEFT">
											<Offset>
												<AbsDimension x="37" y="-1" />
											</Offset>
										</Anchor>
									</Anchors>
									<Color r="1" g="1" b="1" />
								</FontString>
								<!-- DkpValue -->
								<FontString name="$parentDkpValue" justifyH="LEFT"
									inherits="GameFontNormal"
									font="Fonts\FRIZQT__.TTF">
									<FontHeight val="10" />
									<Size>
										<AbsDimension x="296" y="10" />
									</Size>
									<Anchors>
										<Anchor point="TOPLEFT">
											<Offset>
												<AbsDimension x="37" y="-13" />
											</Offset>
										</Anchor>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
						<Scripts>
							<OnClick>
								SOTA_OnEarnBossDkp(this);
							</OnClick>
							<OnEnter>
								getglobal(this:GetName().."BG"):SetVertexColor(1, 1, 1, 1)
							</OnEnter>
							<OnLeave>
								getglobal(this:GetName().."BG"):SetVertexColor(0.5, 0.5, 0.3, 1)
								GameTooltip:Hide();
							</OnLeave>
							<OnLoad>
								this:GetScript("OnLeave")(this)
							</OnLoad>
						</Scripts>
						<NormalTexture name="$parentBG">
							<Color r="0.0" g="0.0" b="0.2" a="1" />
						</NormalTexture>
					</Button>
					<!-- Cancel Boss DKP button -->
					<Button name="$parentCancelBossDkp" hidden="false">
						<Size>
							<AbsDimension x="26" y="26" />
						</Size>
						<Anchors>
							<Anchor point="LEFT" relativeTo="$parentShareBossDkp" relativePoint="RIGHT">
								<Offset>
									<AbsDimension x="0" y="0" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Up" />
						<PushedTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Down" />
						<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD" />
						<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" tile="true">
							<BackgroundInsets>
								<AbsInset left="0" right="0" top="0" bottom="0" />
							</BackgroundInsets>
						</Backdrop>
						<BackdropColor r="0.5" g="0.0" b="0.0" a="1" />
						<Scripts>
							<OnClick>
								SOTA_OnCancelBossDkp();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "Cancel boss DKP");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip();
							</OnLeave>
						</Scripts>
					</Button>
				</Frames>
				<Layers>
					<Layer level="ARTWORK">
						<FontString inherits="GameFontNormal" text="SOTA" font="Fonts\FRIZQT__.TTF">
							<Anchors>
								<Anchor point="CENTER">
									<Offset>
										<AbsDimension x="00" y="10" />
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
						<FontString name="SOTA_Dash_Stats" inherits="GameFontNormal"
							font="Fonts\FRIZQT__.TTF" text="">
							<FontHeight val="10" />
							<Anchors>
								<Anchor point="CENTER">
									<Offset>
										<AbsDimension x="0" y="-8" />
									</Offset>
								</Anchor>
							</Anchors>
							<Color r="1" g="1" b="1" a="" />
						</FontString>
						<FontString name="SOTA_DashWarn_NotRL" inherits="GameFontNormal"
							font="Fonts\FRIZQT__.TTF" text="NOT RL!" hidden="true">
							<FontHeight val="11" />
							<Anchors>
								<Anchor point="CENTER">
									<Offset>
										<AbsDimension x="-50" y="10" />
									</Offset>
								</Anchor>
							</Anchors>
							<Color r="0.5" g="1" b="0.5" a="" />
						</FontString>
						<FontString name="SOTA_DashWarn_NotML" inherits="GameFontNormal"
							font="Fonts\FRIZQT__.TTF" text="NOT ML!" hidden="true">
							<FontHeight val="11" />
							<Anchors>
								<Anchor point="CENTER">
									<Offset>
										<AbsDimension x="50" y="10" />
									</Offset>
								</Anchor>
							</Anchors>
							<Color r="0.5" g="1" b="0.5" a="" />
						</FontString>
					</Layer>
				</Layers>
			</Frame>
			<!-- Loots list frame -->
			<Frame name="$parentLootsList">
				<Size>
					<AbsDimension x="296" y="170" />
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="0" y="-40" />
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad>
				this:SetMovable(true)
				this:SetUserPlaced(true)
				this:RegisterForDrag("LeftButton")
			</OnLoad>
			<OnDragStart>
				this:StartMoving()
			</OnDragStart>
			<OnDragStop>
				this:StopMovingOrSizing()
			</OnDragStop>
		</Scripts>
	</Frame>
</Ui>