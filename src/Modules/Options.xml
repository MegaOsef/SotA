				</Scripts>
			</CheckButton>
			<CheckButton name="$parentDisableDashboard" inherits="OptionsCheckButtonTemplate">
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset x="32" y="-354"/>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						getglobal(this:GetName().."Text"):SetText("Disable (hide) Dashboard")
					</OnLoad>
					<OnClick>
						SOTA_HandleCheckbox(this);
					</OnClick>
