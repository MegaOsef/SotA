					</Anchors>
				</FontString>
				<!-- Status text for Import Item Priorities -->
				<FontString name="$parentPrioLoadedStr" justifyH="CENTER"
					inherits="GameFontNormal"
					font="Fonts\FRIZQT__.TTF" text="">
					<FontHeight val="12" />
					<Color r="0.6" g="0.6" b="0.6" />
					<Size>
						<AbsDimension x="120" y="15" />
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="217" y="-147" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<!-- Status text for Import Guild Roster Roles -->
				<FontString name="$parentGuildRosterRolesLoadedStr" justifyH="CENTER"
