					<Color r="1" g="0.82" b="0" />
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="32" y="-90" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<!-- Column header for loaded status -->
				<FontString justifyH="CENTER" inherits="GameFontNormal" text="Loaded">
					<FontHeight val="12" />
