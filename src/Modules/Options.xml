				<Size>
					<AbsDimension x="185" y="25" />
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset x="32" y="-232" />
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SOTA_Conf_ExportPlayersDKP_open();
