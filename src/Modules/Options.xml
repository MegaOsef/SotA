<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<Script file="Options.lua" />

	<!-- Configuration frame template -->
	<!-- Frame name="SOTA_ConfigurationFrameTemplate" parent="UIParent" toplevel="true" hidden="true" virtual="true" -->
	<Frame name="SOTA_ConfigurationFrameTemplate" parent="UIParent" toplevel="true" hidden="true" virtual="true">
		<Size>
			<AbsDimension x="384" y="512" />
		</Size>
		<Anchors>
			<Anchor point="TOPLEFT">
				<Offset x="312" y="-124" />
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture file="Interface\Spellbook\Spellbook-Icon">
					<Size>
						<AbsDimension x="58" y="58"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="10" y="-8"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="BarTopLeft" file="Interface\Spellbook\UI-SpellbookPanel-TopLeft">
					<Size>
						<AbsDimension x="256" y="256"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
				</Texture>
				<Texture file="Interface\Spellbook\UI-SpellbookPanel-TopRight">
					<Size>
						<AbsDimension x="128" y="256"/>
					</Size>
					<Anchors>
						<Anchor point="TOPRIGHT"/>
					</Anchors>
				</Texture>
				<Texture file="Interface\Spellbook\UI-SpellbookPanel-BotLeft">
					<Size>
						<AbsDimension x="256" y="256"/>
					</Size>
					<Anchors>
						<Anchor point="BOTTOMLEFT"/>
					</Anchors>
				</Texture>
				<Texture file="Interface\Spellbook\UI-SpellbookPanel-BotRight">
					<Size>
						<AbsDimension x="128" y="256"/>
					</Size>
					<Anchors>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
				<FontString name="$parentTitle" inherits="GameFontNormal" text="SotA Options">
					<Anchors>
						<Anchor point="CENTER">
							<Offset>
								<AbsDimension x="-6" y="233"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
			<Layer>
				<FontString name="$parentTopText" inherits="GameFontNormal" font="Fonts\FRIZQT__.TTF" text="">
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="-90"/>
							</Offset>
						</Anchor>
					</Anchors>
					<FontHeight val="16" />
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<!-- Top right corner close button -->
			<Button name="$parentTopCloseButton" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset x="324" y="-9" />
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SOTA_CloseConfigurationUI();
					</OnClick>
				</Scripts>
			</Button>
			<!-- Lower close button -->
			<Button name="$parentCloseButton" inherits="UIPanelButtonTemplate" text="Close">
				<Size>
					<AbsDimension x="100" y="23" />
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset x="134" y="-432" />
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SOTA_CloseConfigurationUI();
					</OnClick>
				</Scripts>
			</Button>
		</Frames>

		<Scripts>
			<OnLoad>
				this:SetMovable(true)
				this:SetUserPlaced(false)
				this:RegisterForDrag("LeftButton")
			</OnLoad>
			<OnDragStart>
				this:StartMoving()
			</OnDragStart>
			<OnDragStop>
				this:StopMovingOrSizing()
			</OnDragStop>
		</Scripts>
	</Frame>

	<!-- Boss DKP slider (config element for Boss DKP)  -->
	<Slider name="SOTA_BossDKPSlider" minValue="0" maxValue="4000" defaultValue="400" valueStep="100" inherits="OptionsSliderTemplate" virtual="true">
		<Size>
			<AbsDimension x="300" y="14" />
		</Size>
		<Scripts>
			<OnLoad>
				getglobal(this:GetName().."Low"):SetText("0")
				getglobal(this:GetName().."High"):SetText("4000")
			</OnLoad>
			<OnValueChanged>
				SOTA_OnOptionBossDKPChanged(this);
			</OnValueChanged>
		</Scripts>
	</Slider>

	<!-- Template for Message list entries -->
	<Button name="SOTA_TextTemplate" hidden="true" virtual="true">
		<Size>
			<AbsDimension x="278" y="16"/>
		</Size>
		<Layers>
			<Layer>
				<!-- TODO: Insert Channel selector -->
				<FontString name="$parentEvent" justifyH="LEFT" inherits="GameFontNormal" hidden="true">
					<Size>
						<AbsDimension x="0" y="0"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentChannel" justifyH="LEFT" inherits="GameFontNormal" hidden="true">
					<Size>
						<AbsDimension x="0" y="0"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentMessage" justifyH="LEFT" inherits="GameFontNormal">
					<Size>
						<AbsDimension x="274" y="16"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="4" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick>
				SOTA_OnEventMessageClick(this)
				PlaySound("igMainMenuOptionCheckBoxOn")
			</OnClick>
			<OnEnter>
				getglobal(this:GetName().."BG"):SetVertexColor(1, 1, 1, 1)
			</OnEnter>
			<OnLeave>
				getglobal(this:GetName().."BG"):SetVertexColor(0.4, 0.4, 0.4, 0.7)
			</OnLeave>
			<OnLoad>
				this:GetScript("OnLeave")(this)
			</OnLoad>
		</Scripts>
		<NormalTexture name="$parentBG">
			<Color r="0.0" g="0.0" b="0.5" a="0.5"/>
		</NormalTexture>
	</Button>


