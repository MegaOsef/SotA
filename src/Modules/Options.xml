						<Offset x="32" y="-262" />
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SOTA_Conf_TransactionImport_open();
					</OnClick>
				</Scripts>
			</Button>
			<!-- Section 3: Addon Settings -->
			<CheckButton name="$parentEnableDebug" inherits="OptionsCheckButtonTemplate">
