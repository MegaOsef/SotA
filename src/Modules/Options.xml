						SOTA_Conf_ImportBossDkpList_open();
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentConfigImportItemPriosBtn" inherits="UIPanelButtonTemplate" text="Import Item Priorities">
				<Size>
					<AbsDimension x="185" y="25" />
