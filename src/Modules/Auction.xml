<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<Script file="Auction.lua" />

	<!-- template for Bid entries -->
	<Button name="SOTA_BidTemplate" hidden="true" virtual="true">
		<Size>
			<AbsDimension x="420" y="12" />
		</Size>
		<Layers>
			<Layer>
				<!-- Selected star indicator -->
				<Texture name="$parentStar" hidden="true" file="Interface\AddOns\RollFor\assets\star-gold.tga">
					<Size>
						<AbsDimension x="13" y="12" />
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="2" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<!-- Player name -->
				<FontString name="$parentBidder" justifyH="LEFT" inherits="GameFontNormalSmall">
					<Size>
						<AbsDimension x="80" y="12" />
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="16" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="1" g="1" b="1" />
				</FontString>
				<!-- Player bidtype -->
				<FontString name="$parentBidtype" justifyH="CENTER" inherits="GameFontNormalSmall">
					<Size>
						<AbsDimension x="35" y="12" />
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="96" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<!-- Player bid -->
				<FontString name="$parentBid" justifyH="RIGHT" inherits="GameFontNormalSmall">
					<Size>
						<AbsDimension x="35" y="12" />
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="131" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<!-- Remaining DKP after bid -->
				<FontString name="$parentRemaining" justifyH="RIGHT" inherits="GameFontNormalSmall">
					<Size>
						<AbsDimension x="60" y="12" />
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="166" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="0.5" g="0.5" b="0.5" />
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick>
				PlaySound("igMainMenuOptionCheckBoxOn")
				SOTA_OnBidClick(this)
			</OnClick>
			<OnEnter>
				local bg = getglobal(this:GetName().."BG")
				local r, g, b = bg:GetVertexColor()
				this.bgR = r
				this.bgG = g
				this.bgB = b
				bg:SetVertexColor(r * 1.5, g * 1.5, b * 1.5, 0.8)
				SOTA_OnBidRowEnter(this)
			</OnEnter>
			<OnLeave>
				local bg = getglobal(this:GetName().."BG")
				if this.bgR then
					bg:SetVertexColor(this.bgR, this.bgG, this.bgB, 0.5)
				end
				SOTA_OnBidRowLeave(this)
			</OnLeave>
		</Scripts>
		<NormalTexture name="$parentBG">
			<Color r="0.0" g="0.0" b="0.5" a="0.5" />
		</NormalTexture>
	</Button>
	<Button name="SOTA_RaidTemplate" hidden="true" virtual="true">
		<Size>
			<AbsDimension x="290" y="16" />
		</Size>
		<Layers>
			<Layer>
				<FontString name="$parentName" justifyH="LEFT" inherits="GameFontNormal">
					<Size>
						<AbsDimension x="294" y="16" />
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="4" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="1" g="1" b="1" />
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick>
				PlaySound("igMainMenuOptionCheckBoxOn")
				SOTA_OnRaidClick(this)
			</OnClick>
			<OnEnter>
				getglobal(this:GetName().."BG"):SetVertexColor(1, 1, 1, 1)
			</OnEnter>
			<OnLeave>
				getglobal(this:GetName().."BG"):SetVertexColor(0.7, 0.7, 0.7, 0.7)
			</OnLeave>
			<OnLoad>
				this:GetScript("OnLeave")(this)
			</OnLoad>
		</Scripts>
		<NormalTexture name="$parentBG">
			<Color r="0.0" g="0.0" b="0.5" a="0.5" />
		</NormalTexture>
	</Button>
