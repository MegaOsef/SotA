<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<Script file="LogsUI.lua" />

	<!-- template for a Log entry in the Transaction UI -->
	<Button name="SOTA_TransactionTemplate" hidden="true" virtual="true">
		<Size>
			<AbsDimension x="650" y="16"/>
		</Size>
		<Layers>
			<Layer>
				<!-- ID -->
				<FontString name="$parentId" justifyH="LEFT" inherits="GameFontNormal">
					<Size>
						<AbsDimension x="140" y="16"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="4" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<!-- Type -->
				<FontString name="$parentType" justifyH="LEFT" inherits="GameFontNormal">
					<Size>
						<AbsDimension x="80" y="16"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$parentId"/>
					</Anchors>
				</FontString>
				<!-- Auction ID -->
				<FontString name="$parentAuctionId" justifyH="LEFT" inherits="GameFontNormal">
					<Size>
						<AbsDimension x="140" y="16"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$parentType"/>
					</Anchors>
				</FontString>
				<!-- Boss name -->
				<FontString name="$parentBossName" justifyH="LEFT" inherits="GameFontNormal">
					<Size>
						<AbsDimension x="200" y="16"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$parentAuctionId"/>
					</Anchors>
				</FontString>
				<!-- Officer -->
				<FontString name="$parentOfficer" justifyH="LEFT" inherits="GameFontNormal">
					<Size>
						<AbsDimension x="90" y="16"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$parentBossName"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick>
				PlaySound("igMainMenuOptionCheckBoxOn")
				SOTA_OnTransactionLogClick(this)
			</OnClick>
			<OnEnter>
				getglobal(this:GetName().."BG"):SetVertexColor(1, 1, 1, 1)
			</OnEnter>
			<OnLeave>
				getglobal(this:GetName().."BG"):SetVertexColor(0.7, 0.7, 0.7, 0.7)
			</OnLeave>
			<OnLoad>
				this:GetScript("OnLeave")(this)
			</OnLoad>
		</Scripts>
		<NormalTexture name="$parentBG">
			<Color r="0.0" g="0.0" b="0.0" a="0.0"/>
		</NormalTexture>
	</Button>

	<Button name="SOTA_DkpChangeTemplate" hidden="true" virtual="true">
		<Size>
			<AbsDimension x="650" y="16"/>
		</Size>
		<Layers>
			<Layer>
				<!-- ID -->
				<FontString name="$parentId" justifyH="LEFT" inherits="GameFontNormal">
					<Size>
						<AbsDimension x="140" y="16"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="4" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<!-- Player -->
				<FontString name="$parentPlayer" justifyH="LEFT" inherits="GameFontNormal">
					<Size>
						<AbsDimension x="90" y="16"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$parentId"/>
					</Anchors>
				</FontString>
				<!-- Dkp change -->
				<FontString name="$parentChange" justifyH="RIGHT" inherits="GameFontNormal">
					<Size>
						<AbsDimension x="80" y="16"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$parentPlayer"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick>
				PlaySound("igMainMenuOptionCheckBoxOn")
			</OnClick>
			<OnEnter>
				getglobal(this:GetName().."BG"):SetVertexColor(1, 1, 1, 1)
			</OnEnter>
			<OnLeave>
				getglobal(this:GetName().."BG"):SetVertexColor(0.7, 0.7, 0.7, 0.7)
			</OnLeave>
			<OnLoad>
				this:GetScript("OnLeave")(this)
			</OnLoad>
		</Scripts>
		<NormalTexture name="$parentBG">
			<Color r="0.0" g="0.0" b="0.0" a="0.0"/>
		</NormalTexture>
	</Button>


	<!-- Main Log Frame -->
	<Frame name="LogsUIFrame" inherits="SOTAFrame">
		<Layers>
			<Layer>
				<FontString name="$parentTitle" inherits="GameFontNormal" text="SotA Transaction Log">
					<Anchors>
						<Anchor point="CENTER">
							<Offset>
								<AbsDimension x="0" y="233" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<!-- Transaction Log frame -->
			<Frame name="$parentTransactionsList" hidden="true">
				<Size>
					<AbsDimension x="800" y="322" />
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="16" y="-52" />
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
			<!-- Log Details frame -->
			<Frame name="$parentDkpChangesList" hidden="true">
				<Size>
					<AbsDimension x="800" y="322" />
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="16" y="-52" />
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
			<!-- DKP History Frame -->
			<Frame name="$parentDKPHistory" hidden="true">
				<Size>
					<AbsDimension x="320" y="322" />
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="16" y="-92" />
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>

			<!-- Top right corner close button -->
			<Button name="$parentTopCloseButton" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPRIGHT">
						<Offset x="-43" y="-3" />
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SOTA_CloseTransactionUI();
					</OnClick>
				</Scripts>
			</Button>

			<!-- Log frame buttons: PREVious button -->
			<Button name="BtnPrevPage" inherits="UIPanelButtonTemplate" text="Previous Page">
				<Size>
					<AbsDimension x="100" y="23" />
				</Size>
				<Anchors>
					<Anchor point="BOTTOMLEFT">
						<Offset x="15" y="20" />
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SOTA_PreviousTransactionUIPage();
					</OnClick>
				</Scripts>
			</Button>
			<!-- Log frame buttons: NEXT button -->
			<Button name="BtnNextPage" inherits="UIPanelButtonTemplate" text="Next Page">
				<Size>
					<AbsDimension x="100" y="23" />
				</Size>
				<Anchors>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="BtnPrevPage" >
						<Offset x="10" y="0" />
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SOTA_NextTransactionUIPage();
					</OnClick>
				</Scripts>
			</Button>
			<!-- Log Details frame buttons: Back button -->
			<Button name="BtnBack" inherits="UIPanelButtonTemplate" text="Return to transactions">
				<Size>
					<AbsDimension x="200" y="23" />
				</Size>
				<Anchors>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="BtnNextPage" >
						<Offset x="10" y="0" />
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SOTA_CloseTransactionDetails();
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
	</Frame>
</Ui>
